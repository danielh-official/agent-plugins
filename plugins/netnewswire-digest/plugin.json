{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "netnewswire-digest",
  "version": "0.0.1",
  "description": "Pull articles from NetNewsWire by filter (unread, starred, folder, feed, recency), then rank them by relevance to you and summarize.",
  "author": {
    "name": "Daniel Haven",
    "url": "https://github.com/danielh-official"
  },
  "homepage": "https://github.com/danielh-official/agent-plugins/tree/main/plugins/netnewswire-digest",
  "repository": "https://github.com/danielh-official/agent-plugins",
  "license": "MIT",
  "keywords": ["netnewswire", "rss", "macos", "applescript", "digest", "summarize"],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "NetNewsWire Digest",
        "shortDescription": "Summarize local NetNewsWire articles on macOS.",
        "category": "Productivity",
        "defaultPrompt": [
          "Summarize my unread NetNewsWire articles."
        ]
      }
    }
  }
}
